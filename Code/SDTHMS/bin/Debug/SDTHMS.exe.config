<?xml version="1.0" encoding="utf-8" ?>
<configuration>
		<connectionStrings>
			<add name="SDTHMS"
				 connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=SDTHMS;Integrated Security=True;"
				 providerName="System.Data.SqlClient" />
		</connectionStrings>

	    <appSettings>
			<add key="AdminUsername" value="admin" />
			<add key="AdminPassword" value="admin" />
		</appSettings>
	
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
	</configuration>